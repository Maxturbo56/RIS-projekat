<!DOCTYPE html>
<html lang="bs">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Astral Nexus</title>
    <link rel="icon" type="image/png" href="~/images/branding/logo-icon.png" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
@{ var selectedTheme = Context.Request.Cookies["AstralNexus.Theme"] ?? "Dark"; }
<body class="theme-@selectedTheme.ToLowerInvariant()">
<header class="topbar">
    <a class="brand" asp-controller="Home" asp-action="Index">
        <img src="~/images/branding/logo-icon.png" alt="Astral Nexus" />
        <span>ASTRAL NEXUS</span>
    </a>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <nav class="main-nav">
            <a asp-controller="Dashboard" asp-action="Index">Dashboard</a>
            <a asp-controller="Collection" asp-action="Index">Kolekcija</a>
            <a asp-controller="Decks" asp-action="Index">Špilovi</a>
            <a asp-controller="Shop" asp-action="Index">Paketi</a>
            <a asp-controller="Game" asp-action="Index">Meč</a>
            <a asp-controller="Profile" asp-action="Index">Profil</a>
            @if (User.IsInRole("Admin"))
            {
                <a class="admin-link" asp-controller="Admin" asp-action="Index">Admin</a>
            }
        </nav>

        <div class="account-box">
            <span>@User.Identity.Name</span>
            <form asp-controller="Account" asp-action="Logout" method="post">
                <button class="link-button" type="submit">Odjava</button>
            </form>
        </div>
    }
    else
    {
        <nav class="main-nav">
            <a asp-controller="Account" asp-action="Login">Prijava</a>
            <a class="button small" asp-controller="Account" asp-action="Register">Registracija</a>
        </nav>
    }
</header>

<main class="page-shell">
    @if (TempData["Success"] is string success)
    {
        <div class="alert success">@success</div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="alert error">@error</div>
    }

    @RenderBody()
</main>

<footer class="footer">
    <span>Astral Nexus · ASP.NET Core / C# / Microsoft SQL Server</span>
    <a href="/api/cards" target="_blank" rel="noreferrer">REST API: /api/cards</a>
</footer>
</body>
</html>
