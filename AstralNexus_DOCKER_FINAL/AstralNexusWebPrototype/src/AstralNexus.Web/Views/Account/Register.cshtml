@model RegisterViewModel
@{
    ViewData["Title"] = "Registracija";
}
<section class="auth-shell">
    <form class="panel auth-card" asp-action="Register" method="post">
        <h1>Registracija</h1>
        <p class="muted">Novi korisnik dobija 500 coina i početnu kolekciju.</p>

        <div asp-validation-summary="ModelOnly" class="validation"></div>

        <label asp-for="UserName"></label>
        <input asp-for="UserName" autocomplete="username" />
        <span asp-validation-for="UserName" class="validation"></span>

        <label asp-for="Email"></label>
        <input asp-for="Email" autocomplete="email" />
        <span asp-validation-for="Email" class="validation"></span>

        <label asp-for="Password"></label>
        <input asp-for="Password" autocomplete="new-password" />
        <span asp-validation-for="Password" class="validation"></span>

        <label asp-for="ConfirmPassword"></label>
        <input asp-for="ConfirmPassword" autocomplete="new-password" />
        <span asp-validation-for="ConfirmPassword" class="validation"></span>

        <button class="button full" type="submit">Kreiraj profil</button>
    </form>
</section>
